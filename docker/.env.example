# Zammad version for the bundled local dev stack (Docker image tag).
# Supported tags: 7.1 (default), 7.0, 6.5, 6.3
# See docker/README.md and docs/COMPATIBILITY.md before changing major versions.
ZAMMAD_VERSION=7.1

# API token for the zammad-mcp-server container to authenticate to Zammad.
# Zammad has no default token — create one after the stack is up:
# http://localhost:8080 -> Profile -> Token Access. Then set it here and
# run `docker compose up -d zammad-mcp-server` (or `podman compose ...`).
ZAMMAD_HTTP_TOKEN=

# Bearer token MCP clients (e.g. Claude) must present to the MCP server.
# Any string works for local testing; generate a real one with
# `openssl rand -hex 32` before using this outside your machine.
MCP_CLIENT_TOKEN=local-dev-token
